# ArrChestra: configure only what you use; absent services are disabled.
# Existing Seerr/Jellyseerr variable names remain supported.
# JELLYSEERR_URL=https://seerr.example.com
# JELLYSEERR_API_KEY=replace-me

# RADARR_URL=https://radarr.example.com
# RADARR_API_KEY=replace-me
# SONARR_URL=https://sonarr.example.com
# SONARR_API_KEY=replace-me
# NZBGET_URL=http://nzbget:6789
# NZBGET_USERNAME=replace-me
# NZBGET_PASSWORD=replace-me
# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=replace-me
# NZBHYDRA_URL=https://hydra.example.com
# NZBHYDRA_API_KEY=replace-me

# Tautulli is read-only (watch history and Plex library questions); no write opt-in exists.
# TAUTULLI_URL=http://tautulli:8181
# TAUTULLI_API_KEY=replace-me

MCP_REQUEST_TIMEOUT=15
# Optional per-service overrides: JELLYSEERR_TIMEOUT, RADARR_TIMEOUT, etc.
# Release/target search fans out over every indexer and is much slower than a
# metadata read, so it gets its own deadline instead of sharing the one above.
MCP_SEARCH_TIMEOUT=120
# Optional: RADARR_SEARCH_TIMEOUT, SONARR_SEARCH_TIMEOUT (0 = use the request timeout).
LOG_LEVEL=INFO

# Safe default. Both global and per-service opt-ins are required for writes.
MCP_READ_ONLY=true
# JELLYSEERR_ALLOW_WRITES=true
# RADARR_ALLOW_WRITES=true
# SONARR_ALLOW_WRITES=true
# NZBGET_ALLOW_WRITES=true
# SABNZBD_ALLOW_WRITES=true

# Legacy raw_request: only allowlisted GET status, never arbitrary endpoints.
MCP_ALLOW_RAW_READ=false

# Only if Hydra redirects NZB retrieval to trusted indexers. Origins, not URLs
# with API keys or paths. No Hydra credentials are forwarded cross-origin.
# NZBHYDRA_ALLOWED_REDIRECT_ORIGINS=https://indexer.example.com,https://other.example.com

# stdio only. SSE/HTTP are disabled until verified authentication is implemented.
